{
  "schema_version": 3,
  "project_id": "example-obsidian-project",
  "project_name": "Obsidian 项目示例",
  "agent": {
    "name": "Agent Context OS",
    "mode": "thin-launcher",
    "version": "0.2.0",
    "source": "../.."
  },
  "memory": {
    "sources": [
      {
        "id": "project-vault",
        "provider": "obsidian",
        "path": "knowledge",
        "required_frontmatter": ["id", "type", "status", "summary"]
      }
    ],
    "local_index": {
      "provider": "embedded-json",
      "path": ".agent-context/local-index",
      "git_tracked": false
    }
  },
  "quality": {
    "check_command": "scripts/check-agent.ps1",
    "validation_commands": ["node --test"]
  }
}
