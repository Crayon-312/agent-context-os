{
  "schema_version": 3,
  "project_id": "<项目ID>",
  "project_name": "<项目名>",
  "agent": {
    "name": "Agent Context OS",
    "mode": "thin-launcher",
    "version": "<Agent 版本>",
    "source": "<本机 Agent 路径或包名>"
  },
  "memory": {
    "sources": [
      {
        "id": "project-vault",
        "provider": "obsidian",
        "path": "<Obsidian Vault 路径>",
        "required_frontmatter": [
          "id",
          "type",
          "status",
          "summary"
        ]
      }
    ],
    "local_index": {
      "provider": "embedded-json",
      "path": ".agent-context/local-index",
      "git_tracked": false
    }
  },
  "quality": {
    "check_command": "scripts/check-agent.ps1",
    "validation_commands": [
      "<验证命令>"
    ]
  }
}
